{
  "name": "past-paper-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "local": "node scripts/dev-local.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "smoke:ai": "vitest run functions/_shared/aiProxy.test.ts",
    "smoke:gemini": "vitest run functions/_shared/aiProxy.test.ts",
    "e2e": "playwright test -c playwright.config.cjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "framer-motion": "^12.23.24",
    "katex": "^0.17.0",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.35.0",
    "@cloudflare/workers-types": "^4.20260527.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "jsdom": "24.1.3",
    "playwright": "^1.60.0",
    "typescript": "5.6.3",
    "vite": "^6.4.2",
    "vitest": "1.6.1",
    "wrangler": "^4.87.0"
  }
}
